# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Two consumers read it:
#   - the web app, via next.config.ts, which loads this file before a build
#   - the pipeline, via config.py, which loads it on import
#
# Neither overrides anything already in the environment, so in CI - where the
# workflows pass the same names from repository variables and secrets - this
# file is absent and nothing here applies.


# ---------------------------------------------------------------------------
# Cloudflare R2 — writing the export
# ---------------------------------------------------------------------------
#
# From the dashboard: R2 -> Manage R2 API Tokens -> Create API Token, with
# Object Read & Write scoped to the bucket. The values are shown once.
#
# R2_ENDPOINT is the *S3 write API*. The browser never touches it.

R2_BUCKET=znhstry-data
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: derived from R2_ACCOUNT_ID when left blank.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com


# ---------------------------------------------------------------------------
# Cloudflare R2 — reading it in the browser
# ---------------------------------------------------------------------------
#
# The bucket's *public* URL, which is a different thing from R2_ENDPOINT above.
# It only exists once public access is turned on: bucket -> Settings -> either
# "Public Development URL" (gives https://pub-<hash>.r2.dev) or a custom domain.
#
# Prefer a custom domain. One cold page load fetches close to a thousand small
# files; r2.dev is rate-limited and explicitly not for production, and a CDN
# cache hit behind a custom domain is not a billed read.
#
# Leave blank for local work - the app falls back to `npm run data` on :3002.
# No trailing slash: the client appends "/global".
#
# NEXT_PUBLIC_DATA_ORIGIN is the name used here; NEXT_PUBLIC_R2_URL also works.

# NEXT_PUBLIC_DATA_ORIGIN=https://data.featheranalytics.dev


# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
#
# Set only when building for GitHub Pages, which serves the site under a
# subdirectory. Never set for local dev.

# NEXT_PUBLIC_BASE_PATH=/znhstry
